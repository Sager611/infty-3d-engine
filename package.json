{
	"name": "infty-3d-engine",
	"private": true,
	"type": "module",
	"scripts": {
		"build:wasm": "wasm-pack build --target web --dev",
		"build:web": "bun build web/app.ts --outdir dist --target browser --external ./pkg/infty.js --minify",
		"dev": "bun serve.ts",
		"check": "tsc --noEmit && biome check --error-on-warnings web serve.ts index.html package.json tsconfig.json biome.json"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@types/bun": "1.3.5",
		"typescript": "5.9.3"
	}
}
